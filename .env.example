# eBird API token — generate at https://ebird.org/api/keygen
EBIRD_API_TOKEN=your_ebird_api_token_here

# OpenWeatherMap API key — generate at https://home.openweathermap.org/api_keys
OWM_API_KEY=your_openweathermap_api_key_here

# Mapbox access token — generate at https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=your_mapbox_access_token_here

# Gmail OAuth2 credentials. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (Gmail API scope), then generate a refresh
# token (e.g. via https://developers.google.com/oauthplayground using your own client ID/secret).
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
GMAIL_SENDER_EMAIL=the_gmail_address_that_sends_the_report@gmail.com

# Recipient of the report email (defaults to tausif.farooqi@gmail.com if unset, matching the
# original workflow)
EMAIL_TO=tausif.farooqi@gmail.com

# Home base coordinates: center of the eBird search radius and the Mapbox driving-distance
# origin (defaults match the original workflow's hardcoded values if unset)
HOME_LAT=37.4894467
HOME_LNG=-121.9370132

# eBird search radius in km, and how many days back to look for notable sightings (defaults
# match the original workflow's hardcoded query string if unset)
EBIRD_DIST_KM=50
EBIRD_BACK_DAYS=7

# Optional: IANA timezone for the weekly cron schedule in scheduler.js (defaults to the system's
# local timezone if unset), e.g. America/Los_Angeles
CRON_TIMEZONE=
